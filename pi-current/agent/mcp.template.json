{
  "mcpServers": {
    "brokan": {
      "command": "$HOME/.local/bin/brokan",
      "args": [
        "mcp"
      ]
    },
    "agentmemory": {
      "command": "/opt/homebrew/bin/node",
      "args": [
        "$HOME/.local/share/agentmemory-package/node_modules/@agentmemory/agentmemory/dist/standalone.mjs"
      ],
      "env": {
        "AGENTMEMORY_TOOLS": "all",
        "AGENTMEMORY_FORCE_PROXY": "1"
      },
      "exposure": "deferred"
    },
    "figma-console": {
      "command": "/opt/homebrew/bin/node",
      "args": [
        "$HOME/.local/share/figma-console-mcp/node_modules/figma-console-mcp/dist/local.js"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "<SET_LOCALLY>",
        "ENABLE_MCP_APPS": "true"
      },
      "description": "Figma design system as an API: read and write Figma files, variables, components, tokens, FigJam boards and slides, plus accessibility and design-code parity checks. Write tools need the Figma Desktop Bridge plugin running in Figma Desktop.",
      "timeout": 120,
      "exposure": "deferred"
    }
  }
}
