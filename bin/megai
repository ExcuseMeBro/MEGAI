#!/usr/bin/env bash
# MEGAI launcher: harness-neutral policies and local Headroom.
set -euo pipefail
MEGAI_HOME="${MEGAI_HOME:-$HOME/.megai}"
LIB="$MEGAI_HOME/lib"
. "$LIB/ui.sh"
. "$LIB/state.sh"

usage() {
  cat <<'EOF'
megai
  megai                         Check installed policy and worktree safety
  cc | codex | pi | omp [args]  Launch with native argument forwarding
  install | update              Install/reuse the shared tool entries
  status | doctor               Report core availability (no service startup)
  wire cc|codex|pi|omp|path     Repair managed wiring; conflicts fail safely
  headroom doctor|compress|retrieve|recall|save [args]
                                Local compression, retrieval and memory CLI
  reindex                       Explicit local zvec index/rebuild
  plane [args]                  Secure Plane connector setup/status/removal
  dev | finish | promote       Explicit branch lifecycle commands
  uninstall                     Detach owned wiring; retain tools and data
  version | help

Stack: tgrep, codedb, zvec-grep, local Headroom, Plane-only task-flow, Ruff,
       agent-worktree-lifecycle, ux-ui-agent-skills, Matt Pocock's skills.
Defaults: tgrep text (rg fallback), codedb structure, zvec intent.
EOF
}

cmd_wire() {
  case "${1:-}" in
    cc|codex|pi|omp|path) bash "$LIB/wire_$1.sh" ;;
    *) die "wire expects cc, codex, pi, omp, or path" ;;
  esac
}

prepare_core() {
  python3 "$LIB/slim_wiring.py" all --verify
  bash "$LIB/ensure_dev.sh" --launch
  ok "MEGAI ready — Headroom/search run only when requested"
}

launch_agent() {
  local agent="$1" bin="$2"; shift 2
  command -v "$bin" >/dev/null 2>&1 || die "$bin is not installed; install/authenticate that harness separately"
  # Validate only the selected harness before every native launch; never alter native args.
  python3 "$LIB/slim_wiring.py" "$agent" --verify
  bash "$LIB/ensure_dev.sh" --launch
  exec "$bin" "$@"
}

cmd_omp() {
  local profile="${OMP_PROFILE:-${PI_PROFILE:-}}" expect=0 arg
  for arg in "$@"; do
    if [ "$expect" = 1 ]; then profile="$arg"; expect=0; continue; fi
    case "$arg" in --profile) expect=1 ;; --profile=*) profile="${arg#--profile=}" ;; esac
  done
  [ "$expect" = 0 ] || die "--profile needs a value"
  export OMP_PROFILE="$profile"
  launch_agent omp omp "$@"
}

cmd_status() {
  local tool
  for tool in tgrep codedb zg ruff git rg; do
    if command -v "$tool" >/dev/null 2>&1; then ok "$tool -> $(command -v "$tool")"; else warn "$tool missing"; fi
  done
  if [ -x "$MEGAI_HOME/bin/megai-headroom" ]; then ok "headroom -> $MEGAI_HOME/bin/megai-headroom"; else warn "headroom wiring missing"; fi
  echo "Headroom, tgrep server/index and zvec indexes are explicit/on demand. Plane: megai plane status --client all"
}

cmd_doctor() {
  cmd_status
  python3 "$LIB/slim_wiring.py" all --verify
  local tool
  for tool in python3 node jq git rg tgrep codedb zg ruff; do command -v "$tool" >/dev/null 2>&1 || die "$tool required"; done
  [ -x "$MEGAI_HOME/bin/megai-headroom" ] || die "Headroom CLI missing; run megai install"
  [ -f "$MEGAI_HOME/ux-ui-agent-skills/package.json" ] && [ -f "$MEGAI_HOME/ux-ui-agent-skills/.megai-skills/a11y-audit/SKILL.md" ] || die "UX/UI kit is incomplete; run megai install"
  [ -d "$MEGAI_HOME/mattpocock-skills/skills" ] && find "$MEGAI_HOME/mattpocock-skills/skills" -type f -name SKILL.md -print -quit | grep -q . || die "Matt skill kit is incomplete; run megai install"
  local ruff_version; ruff_version="$(ruff --version)" || die "Ruff version check failed"
  [[ "$ruff_version" == ruff\ * ]] || die "Ruff returned invalid version output"
  # Explicit doctor checks local compression/inference, not just an executable
  # or Pi tool registration. No runtime probe is added to harness launch.
  python3 -I -B -c 'import subprocess, sys; subprocess.run([sys.argv[1], "doctor"], check=True, timeout=30)' \
    "$MEGAI_HOME/bin/megai-headroom" || die "Headroom runtime verification failed"
  if command -v pi >/dev/null 2>&1; then
    if bash "$LIB/verify_headroom_activation.sh" >/dev/null; then
      ok "Pi Headroom adapter is active"
    else
      local activation_status=$?
      if [ "$activation_status" = 2 ]; then
        warn "Pi Headroom is installed but deliberately excluded by resource selection"
      else
        die "Pi Headroom runtime verification failed"
      fi
    fi
  else
    warn "Pi is unavailable; native Headroom activation was not checked"
  fi
  ok "MEGAI wiring preflight passed; not a provider, model-quality, or live Plane check"
}

cmd_headroom() {
  [ "$#" -gt 0 ] || die "headroom expects doctor, compress, retrieve, recall, or save"
  case "$1" in doctor|compress|retrieve|recall|save) ;; *) die "unknown Headroom action: $1" ;; esac
  exec "$MEGAI_HOME/bin/megai-headroom" "$@"
}

cmd_start() { die "agent-memory is retired; use megai headroom recall/save"; }
cmd_stop() { die "agent-memory is retired; use megai headroom recall/save"; }
cmd_logs() { die "agent-memory is retired; use megai headroom doctor"; }

cmd_reindex() {
  command -v zg >/dev/null 2>&1 || die "zvec-grep missing; run megai install"
  local root embedding; root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  if [ -f "$root/.zvec-grep/manifest.json" ]; then zg index "$root" --rebuild
  else
    embedding="${MEGAI_ZVEC_EMBEDDING:-local/potion-code-16m-v2}"
    case "$embedding" in local/*) ;; *) die "remote embedding requires explicit separate authorization" ;; esac
    zg index "$root" --embedding "$embedding"
  fi
}

cmd_uninstall() {
  local answer
  warn "Detach owned MEGAI wiring? Tools, credentials, indexes and data remain. [y/N]"
  read -r answer; [ "$answer" = y ] || return 0
  python3 "$LIB/slim_wiring.py" all --remove --check
  python3 "$LIB/retire_legacy_sources.py" --check
  # Detach connectors before any asset retirement; a failure preserves every asset.
  bash "$LIB/plane_mcp.sh" remove --client all || die "Plane removal failed; assets preserved"
  bash "$LIB/retire_argent.sh"
  bash "$LIB/retire_numasec.sh"
  bash "$LIB/retire_openspec.sh"
  python3 "$LIB/retire_legacy_sources.py"
  python3 "$LIB/slim_wiring.py" all --remove || die "Wiring removal failed; recovery manifests retained"
  ok "MEGAI wiring detached; tools, skill kits, backups and project data retained"
}

case "${1:-__project__}" in
  cc) shift; launch_agent cc claude "$@" ;;
  codex) shift; launch_agent codex codex "$@" ;;
  pi) shift; launch_agent pi pi "$@" ;;
  omp) shift; cmd_omp "$@" ;;
  install) bash "$LIB/main.sh" ;;
  update) MEGAI_UPDATE=1 bash "$LIB/main.sh" ;;
  wire) shift; cmd_wire "$@" ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  headroom) shift; cmd_headroom "$@" ;;
  start) shift; cmd_start "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  reindex) cmd_reindex ;;
  plane) shift; bash "$LIB/plane_mcp.sh" "$@" ;;
  dev) bash "$LIB/ensure_dev.sh" ;;
  finish) shift; bash "$LIB/finish_worktree.sh" "$@" ;;
  promote) shift; bash "$LIB/promote_main.sh" "$@" ;;
  uninstall) cmd_uninstall ;;
  version|-v|--version) echo 'megai slim 0.1.0' ;;
  help|-h|--help) usage ;;
  __project__) prepare_core ;;
  *) die "unknown slim command: $1 (megai help)" ;;
esac
