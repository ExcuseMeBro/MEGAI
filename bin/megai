#!/usr/bin/env bash
# megai — CLI entry
set -euo pipefail

MEGAI_HOME="${MEGAI_HOME:-$HOME/.megai}"
LIB="$MEGAI_HOME/lib"

# shellcheck source=../lib/ui.sh
. "$LIB/ui.sh"
# shellcheck source=../lib/detect.sh
. "$LIB/detect.sh"
# shellcheck source=../lib/state.sh
. "$LIB/state.sh"
# shellcheck source=../lib/banner.sh
. "$LIB/banner.sh"

usage() {
  cat <<EOF
megai — zero-config AI agent stack manager

Usage:
  megai                 Activate stack for current project (default)
                          • starts agent-memory daemon
                          • indexes the folder with codedb
                          • verifies MCP/skill bindings
                          • prints quick guide

Commands:
  cc                    Launch Claude Code CLI + Fusion dashboard (wired)
  codex                 Launch Codex CLI + Fusion dashboard (wired)
  pi                    Launch Pi CLI + Fusion dashboard (wired)
  fusion                Launch Fusion dashboard only
  install               Re-run installer (idempotent)
  status                Show tools/ports/versions
  doctor                Diagnose problems
  reindex               Force re-index this project with codedb
  start [tool]          Start daemon (agent-memory)
  stop  [tool]          Stop daemon (agent-memory | fusion)
  update                Update all tools
  wire <cc|codex|pi|path>  Re-wire MCP config / shell PATH (no launch)
  logs [tool]           Tail log
  uninstall             Remove megai + revert configs
  version               Print version
  help                  This message

Tools: fusion, agent-memory, codedb, cocoindex, caveman, rtk
EOF
}

cmd_install() {
  bash "$LIB/main.sh"
}

cmd_status() {
  detect_os; detect_runtimes; state_init
  printf "%-14s %-10s %-8s %s\n" TOOL VERSION PORT STATUS
  for t in fusion agent-memory codedb cocoindex caveman rtk; do
    local ver port stat bin
    ver=$(state_get ".tools[\"$t\"].version") || ver=""
    port=$(state_get ".tools[\"$t\"].port")   || port=""
    bin=$(state_get ".tools[\"$t\"].bin")     || bin=""
    if [ -n "$bin" ] && [ -x "$bin" ]; then stat="installed"; else stat="missing"; fi
    printf "%-14s %-10s %-8s %s\n" "$t" "${ver:--}" "${port:--}" "$stat"
  done
}

cmd_doctor() {
  detect_os; detect_runtimes
  say "OS: $MEGAI_OS/$MEGAI_ARCH"
  for c in curl jq node npm python3 pipx; do
    if command -v "$c" >/dev/null 2>&1; then ok "$c -> $(command -v "$c")"
    else err "$c missing"; fi
  done
  for f in "$HOME/.claude.json" "$HOME/.codex/config.toml" "$HOME/.pi/agent/skills/megai.md"; do
    if [ -e "$f" ]; then ok "$f"
    else skip "$f (not present)"; fi
  done
  if command -v agentmemory >/dev/null 2>&1; then ok "agent-memory CLI present"; else err "agent-memory missing"; fi
  if command -v codedb      >/dev/null 2>&1; then ok "codedb CLI present";       else err "codedb missing"; fi
  if command -v cocoindex   >/dev/null 2>&1; then ok "cocoindex CLI present";    else skip "cocoindex missing"; fi
  if command -v fn          >/dev/null 2>&1; then ok "fusion (fn) present";      else skip "fusion missing"; fi
  if command -v caveman     >/dev/null 2>&1; then ok "caveman CLI present";      else skip "caveman missing"; fi
  if command -v rtk         >/dev/null 2>&1; then ok "rtk CLI present";          else skip "rtk missing"; fi
}

cmd_update() {
  bash "$LIB/install_fusion.sh"       || true
  bash "$LIB/install_agent_memory.sh" || true
  bash "$LIB/install_codedb.sh"       || true
  bash "$LIB/install_cocoindex.sh"    || true
  bash "$LIB/install_caveman.sh"      || true
  bash "$LIB/install_rtk.sh"          || true
  ok "update complete"
}

cmd_wire() {
  local agent="${1:-}"
  case "$agent" in
    cc)    bash "$LIB/wire_cc.sh" ;;
    codex) bash "$LIB/wire_codex.sh" ;;
    pi)    bash "$LIB/wire_pi.sh" ;;
    path)  bash "$LIB/wire_path.sh" ;;
    *)     die "usage: megai wire <cc|codex|pi|path>" ;;
  esac
}

cmd_start() {
  local t="${1:-agent-memory}"
  case "$t" in
    agent-memory)
      local port; port="$(state_get '.ports["agent-memory"]')"; port="${port:-3111}"
      mkdir -p "$MEGAI_HOME/logs"
      nohup agentmemory >"$MEGAI_HOME/logs/agent-memory.log" 2>&1 &
      echo $! > "$MEGAI_HOME/agent-memory.pid"
      ok "agent-memory started (pid=$(cat "$MEGAI_HOME/agent-memory.pid"), port=$port)"
      ;;
    *) die "start: only agent-memory is daemonized" ;;
  esac
}

cmd_stop() {
  local t="${1:-agent-memory}"
  case "$t" in
    fusion)
      if pgrep -f "fn dashboard" >/dev/null 2>&1; then
        pkill -f "fn dashboard" || true
        rm -f "$MEGAI_HOME/fusion.pid"
        ok "fusion stopped"
      else
        skip "fusion not running"
      fi
      return
      ;;
  esac
  local pidf="$MEGAI_HOME/$t.pid"
  if [ -f "$pidf" ]; then
    kill "$(cat "$pidf")" 2>/dev/null || true
    rm -f "$pidf"
    ok "$t stopped"
  else
    skip "$t not running"
  fi
}

cmd_logs() {
  local t="${1:-agent-memory}"
  local f="$MEGAI_HOME/logs/$t.log"
  [ -f "$f" ] || die "no log: $f"
  tail -f "$f"
}

cmd_uninstall() {
  warn "Uninstall megai? This will remove ~/.megai and revert MCP configs. [y/N]"
  read -r ans
  [ "$ans" = "y" ] || { skip "cancelled"; return 0; }
  bash "$LIB/wire_cc.sh"    --remove || true
  bash "$LIB/wire_codex.sh" --remove || true
  bash "$LIB/wire_pi.sh"    --remove || true
  bash "$LIB/wire_path.sh"  --remove || true
  rm -rf "$MEGAI_HOME"
  ok "uninstalled"
}

cmd_version() { echo "megai 0.1.0"; }

# ---------- agent launchers ----------

launch_fusion_bg() {
  if ! command -v fn >/dev/null 2>&1; then
    skip "fusion (fn) not installed — skipping dashboard"
    return 0
  fi
  if pgrep -f "fn dashboard" >/dev/null 2>&1; then
    ok "fusion dashboard already running"
    return 0
  fi
  mkdir -p "$MEGAI_HOME/logs"
  nohup fn dashboard >"$MEGAI_HOME/logs/fusion.log" 2>&1 &
  local pid=$!
  echo "$pid" > "$MEGAI_HOME/fusion.pid"
  sleep 2
  local url
  url="$(grep -oE 'https?://[^[:space:]]+' "$MEGAI_HOME/logs/fusion.log" 2>/dev/null | head -1 || true)"
  if [ -n "$url" ]; then
    ok "fusion dashboard -> $url"
  else
    ok "fusion dashboard launched (pid=$pid, see: megai logs fusion)"
  fi
}

ensure_wired() {
  state_init
  local agent="$1"
  local wired; wired="$(state_get ".agents[\"$agent\"].wired")"
  if [ "$wired" != "true" ]; then
    bash "$LIB/wire_${agent}.sh" || warn "$agent wiring had issues"
  fi
}

# launch <agent-key> <cli-binary> [arg...]
launch_agent() {
  local agent="$1"; shift
  local bin="$1";   shift
  local proj; proj="$(pwd)"

  megai_banner
  printf "%s[megai]%s launching %s%s%s in %s\n" "$C_BLUE" "$C_OFF" "$C_GRN" "$agent" "$C_OFF" "$proj"

  ensure_wired "$agent"
  ensure_agent_memory
  launch_fusion_bg

  if ! command -v "$bin" >/dev/null 2>&1; then
    err "$bin CLI not found in PATH."
    case "$bin" in
      claude) echo "    Install: https://docs.claude.com/en/docs/claude-code/setup" ;;
      codex)  echo "    Install: https://github.com/openai/codex" ;;
      pi)     echo "    Install: curl -fsSL https://pi.dev/install.sh | sh" ;;
    esac
    return 1
  fi

  ok "starting $bin …"
  exec "$bin" "$@"
}

cmd_cc()     { launch_agent cc    claude "$@"; }
cmd_codex()  { launch_agent codex codex  "$@"; }
cmd_pi()     { launch_agent pi    pi     "$@"; }
cmd_fusion() {
  megai_banner
  launch_fusion_bg
  # Foreground: tail the log so the user sees activity.
  ok "tailing fusion log (Ctrl-C to detach; dashboard keeps running)"
  tail -f "$MEGAI_HOME/logs/fusion.log"
}

# ---------- project bootstrap (default action) ----------

is_port_listening() {
  lsof -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

ensure_agent_memory() {
  state_init
  local port; port="$(state_get '.ports["agent-memory"]')"; port="${port:-3111}"
  if is_port_listening "$port"; then
    ok "agent-memory running -> :$port"
    return
  fi
  if ! command -v agentmemory >/dev/null 2>&1; then
    warn "agent-memory missing — run: megai install"
    return
  fi
  mkdir -p "$MEGAI_HOME/logs"
  nohup agentmemory >"$MEGAI_HOME/logs/agent-memory.log" 2>&1 &
  echo $! > "$MEGAI_HOME/agent-memory.pid"
  sleep 1
  if is_port_listening "$port"; then
    ok "agent-memory started -> :$port (pid=$(cat "$MEGAI_HOME/agent-memory.pid"))"
  else
    warn "agent-memory failed to bind :$port — see $MEGAI_HOME/logs/agent-memory.log"
  fi
}

ensure_codedb_index() {
  local proj="$1"
  if ! command -v codedb >/dev/null 2>&1; then
    warn "codedb missing — run: megai install"
    return
  fi
  state_init
  local proj_key; proj_key="$(printf '%s' "$proj" | sed 's/[\"]/_/g')"
  local indexed; indexed="$(state_get ".projects[\"$proj_key\"].indexed_at" 2>/dev/null)"
  if [ -n "$indexed" ]; then
    ok "codedb index ready ($indexed)"
    return
  fi
  printf "  %s↻%s codedb indexing %s ...\n" "$C_BLUE" "$C_OFF" "$proj"
  if codedb index "$proj" >/dev/null 2>&1; then
    state_set ".projects[\"$proj_key\"]" "{\"path\":\"$proj\",\"indexed_at\":\"$(date -u +%FT%TZ)\"}"
    ok "codedb indexed -> $proj"
  else
    warn "codedb index failed (continuing)"
  fi
}

check_caveman() {
  if command -v caveman >/dev/null 2>&1; then ok "caveman skill active"
  else skip "caveman not installed"; fi
}

check_rtk() {
  if command -v rtk >/dev/null 2>&1; then
    local ver; ver="$(rtk --version 2>/dev/null | head -n1 || echo "rtk")"
    ok "rtk proxy hook: $ver"
  else
    skip "rtk not installed"
  fi
}

check_mcp_wired() {
  state_init
  local cc cx pi
  cc="$(state_get '.agents["cc"].wired')";    [ "$cc" = "true" ] && ok "cc MCP wired"    || skip "cc MCP not wired (megai wire cc)"
  cx="$(state_get '.agents["codex"].wired')"; [ "$cx" = "true" ] && ok "codex MCP wired" || skip "codex MCP not wired (megai wire codex)"
  pi="$(state_get '.agents["pi"].wired')";    [ "$pi" = "true" ] && ok "pi skill wired"  || skip "pi skill not wired (megai wire pi)"
}

print_quick_guide() {
  local proj="$1"
  cat <<EOF

${C_BLUE}━━━ MEGAI ready for ${proj} ━━━${C_OFF}

${C_GRN}Memory${C_OFF}  (persistent across sessions)
  megai-memory save "<observation>"
  megai-memory recall "<query>"
  megai-memory sessions

${C_GRN}Code search${C_OFF}
  megai-codedb search "<pattern>"
  megai-codedb symbol <name>
  megai-codedb outline <file>
  megai-codedb tree

${C_GRN}Agents${C_OFF}  (launches CLI + Fusion dashboard, MCP/skill already wired)
  megai cc       — Claude Code   (agentmemory + codedb MCP)
  megai codex    — Codex CLI     (agentmemory + codedb MCP)
  megai pi       — Pi            (megai-memory + megai-codedb extensions)
  megai fusion   — Fusion dashboard only

${C_GRN}Manage${C_OFF}
  megai status     megai doctor     megai stop     megai update

${C_DIM}Token savers active: caveman (skill), rtk (proxy hook).${C_OFF}
EOF
}

cmd_project() {
  detect_os; detect_runtimes; state_init
  local proj; proj="$(pwd)"
  local name; name="$(basename "$proj")"

  megai_banner
  printf "%s[megai]%s project: %s%s%s  (%s)\n" "$C_BLUE" "$C_OFF" "$C_GRN" "$name" "$C_OFF" "$proj"

  step 1 4 "agent-memory daemon"
  ensure_agent_memory

  step 2 4 "codedb index"
  ensure_codedb_index "$proj"

  step 3 4 "MCP / skill bindings"
  check_mcp_wired

  step 4 4 "token savers"
  check_caveman
  check_rtk

  print_quick_guide "$name"
}

case "${1:-__project__}" in
  cc)        shift; cmd_cc        "$@" ;;
  codex)     shift; cmd_codex     "$@" ;;
  pi)        shift; cmd_pi        "$@" ;;
  fusion)    shift; cmd_fusion    "$@" ;;
  install)   shift; cmd_install   "$@" ;;
  status)    shift; cmd_status    "$@" ;;
  doctor)    shift; cmd_doctor    "$@" ;;
  update)    shift; cmd_update    "$@" ;;
  start)     shift; cmd_start     "$@" ;;
  stop)      shift; cmd_stop      "$@" ;;
  wire)      shift; cmd_wire      "$@" ;;
  logs)      shift; cmd_logs      "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  reindex)   shift; bash "$LIB/state.sh" 2>/dev/null
             jq 'del(.projects["'"$(pwd)"'"])' "$MEGAI_HOME/state.json" > "$MEGAI_HOME/state.json.tmp" && mv "$MEGAI_HOME/state.json.tmp" "$MEGAI_HOME/state.json"
             cmd_project ;;
  version|-v|--version) cmd_version ;;
  help|-h|--help) usage ;;
  __project__) cmd_project ;;
  *) usage; exit 1 ;;
esac
