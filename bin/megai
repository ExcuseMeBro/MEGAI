#!/usr/bin/env bash
# MEGAI slim: eight selected tools, explicit services, Plane-only policies.
set -euo pipefail
MEGAI_HOME="${MEGAI_HOME:-$HOME/.megai}"
LIB="$MEGAI_HOME/lib"
. "$LIB/ui.sh"
. "$LIB/state.sh"

usage() {
  cat <<'EOF'
megai slim
  megai                         Check installed policy and worktree safety
  cc | codex | pi | omp [args]   Launch without daemon/index preparation
  install | update              Install/reuse the eight slim entries
  status | doctor               Report core availability (no service startup)
  wire cc|codex|pi|omp|path      Repair managed wiring; conflicts fail safely
  start | stop [agent-memory]   Explicit memory daemon lifecycle
  logs [agent-memory]           Follow memory log
  reindex                       Explicit local zvec index/rebuild
  plane [args]                  Secure Plane connector setup/status/removal
  dev                           Switch a clean primary main/master to dev
  finish [args]                 Default verified dev delivery (not retained branches)
  promote --approved            User-approved main promotion only
  uninstall                     Detach owned slim wiring; retain tools/data
  version | help

Stack: zvec-grep, rtk, Plane-only task-flow, Ruff, agent-memory,
       agent-worktree-lifecycle, ux-ui-agent-skills, Matt Pocock's skills.
Infrastructure: native tools, rg/Git, lazy Pi MCP adapter.
EOF
}

cmd_wire() {
  case "${1:-}" in
    cc|codex|pi|omp|path) bash "$LIB/wire_$1.sh" ;;
    *) die "wire expects cc, codex, pi, omp, or path" ;;
  esac
}

prepare_core() {
  # Check rather than rewriting global config on every launch. No Plane API call:
  # the parent agent owns its task boundary, not this shell launcher.
  python3 "$LIB/slim_wiring.py" all --verify
  bash "$LIB/ensure_dev.sh" --launch
  ok "slim ready — memory/indexing start only on explicit request"
}

launch_agent() {
  local agent="$1" bin="$2"; shift 2
  command -v "$bin" >/dev/null 2>&1 || die "$bin is not installed; install/authenticate that harness separately"
  python3 "$LIB/slim_wiring.py" "$agent" --verify
  bash "$LIB/ensure_dev.sh" --launch
  exec "$bin" "$@"
}

cmd_omp() {
  local profile="${OMP_PROFILE:-${PI_PROFILE:-}}" expect=0 arg
  for arg in "$@"; do
    if [ "$expect" = 1 ]; then profile="$arg"; expect=0; continue; fi
    case "$arg" in --profile) expect=1 ;; --profile=*) profile="${arg#--profile=}" ;; esac
  done
  [ "$expect" = 0 ] || die "--profile needs a value"
  export OMP_PROFILE="$profile"
  launch_agent omp omp "$@"
}

cmd_status() {
  local tool
  for tool in zg rtk ruff agentmemory git rg; do
    if command -v "$tool" >/dev/null 2>&1; then ok "$tool -> $(command -v "$tool")"; else warn "$tool missing"; fi
  done
  echo "Memory daemon and zvec indexes are explicit/on demand. Plane: megai plane status --client all"
}

cmd_doctor() {
  cmd_status
  python3 "$LIB/slim_wiring.py" all --verify
  local tool
  for tool in python3 node jq git rg zg rtk ruff agentmemory; do command -v "$tool" >/dev/null 2>&1 || die "$tool required"; done
  [ -f "$MEGAI_HOME/ux-ui-agent-skills/package.json" ] && [ -f "$MEGAI_HOME/ux-ui-agent-skills/.megai-skills/a11y-audit/SKILL.md" ] || die "UX/UI kit is incomplete; run megai install"
  [ -d "$MEGAI_HOME/mattpocock-skills/skills" ] && find "$MEGAI_HOME/mattpocock-skills/skills" -type f -name SKILL.md -print -quit | grep -q . || die "Matt skill kit is incomplete; run megai install"
  local ruff_version
  ruff_version="$(ruff --version)" || die "Ruff version check failed"
  [[ "$ruff_version" == ruff\ * ]] || die "Ruff returned invalid version output"
  ok "slim wiring preflight passed; not a provider, model-quality, or live Plane check"
}

cmd_start() (
  [ "${1:-agent-memory}" = agent-memory ] || die "only agent-memory is daemonized"
  command -v agentmemory >/dev/null 2>&1 || die "agent-memory missing; run megai install"
  local port
  port="$(state_get '.ports["agent-memory"]')"; port="${port:-3111}"
  [[ "$port" =~ ^[0-9]{1,5}$ ]] && (( 10#$port >= 1 && 10#$port <= 65535 )) || die "invalid local memory port"
  if curl -fsS --connect-timeout 3 --max-time 5 "http://127.0.0.1:$port/agentmemory/livez" | jq -e '.service == "agentmemory" and .status == "ok"' >/dev/null 2>&1; then
    ok "agent-memory service already available on :$port"; return
  fi
  if lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then die "port $port occupied; reconcile before starting memory"; fi
  local record="$MEGAI_HOME/memory-process.json"
  [ ! -e "$record" ] && [ ! -L "$record" ] && [ ! -e "$MEGAI_HOME/agent-memory.pid" ] || die "existing memory process record preserved; reconcile before starting another daemon"
  mkdir -p "$MEGAI_HOME/logs"
  local pid="" registered_pid args started tmp=""
  # Until the record is published, this invocation owns cleanup of its child.
  trap 'rc=$?; trap - EXIT; if [ -n "$pid" ] && ! { [ ! -L "$record" ] && [ "$tmp" -ef "$record" ]; }; then kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; fi; [ -z "$tmp" ] || rm -f "$tmp"; exit "$rc"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  nohup agentmemory --port "$port" >"$MEGAI_HOME/logs/agent-memory.log" 2>&1 &
  pid=$!
  sleep 1
  kill -0 "$pid" 2>/dev/null || die "memory exited; see megai logs"
  args="$(ps -p "$pid" -o command=)"
  started="$(ps -p "$pid" -o lstart=)"
  tmp="$(mktemp "$record.XXXXXX")"
  jq -cn --argjson pid "$pid" --arg args "$args" --arg started "$started" '{pid:$pid,args:$args,started:$started}' >"$tmp"
  # Hard-link publication is atomic and refuses a concurrent process record.
  ln "$tmp" "$record"
  registered_pid="$pid"; pid="" # publication transfers ownership to the record
  rm -f "$tmp"
  trap - EXIT INT TERM
  ok "memory started (pid=$registered_pid, port=$port); megai-memory uses bounded HTTP calls"
)

cmd_stop() {
  [ "${1:-agent-memory}" = agent-memory ] || die "only agent-memory is daemonized"
  local pid file="$MEGAI_HOME/memory-process.json" args started
  [ -f "$file" ] || { skip "no slim-owned process record; legacy/untracked processes are preserved"; return; }
  [ ! -L "$file" ] && [ -O "$file" ] || die "unsafe process record; reconcile manually"
  pid="$(jq -r '.pid' "$file")"
  [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || die "invalid PID; reconcile manually"
  args="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  started="$(ps -p "$pid" -o lstart= 2>/dev/null || true)"
  [ -n "$args" ] && [ "$args" = "$(jq -r '.args' "$file")" ] && [ "$started" = "$(jq -r '.started' "$file")" ] || die "PID identity changed or process exited; record preserved for reconciliation"
  case "$args" in *agentmemory*'--port '*) kill "$pid"; rm -f "$file" ;; *) die "memory PID ownership uncertain; process preserved" ;; esac
}

cmd_reindex() {
  command -v zg >/dev/null 2>&1 || die "zvec-grep missing; run megai install"
  local root embedding
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  if [ -f "$root/.zvec-grep/manifest.json" ]; then
    zg index "$root" --rebuild
  else
    embedding="${MEGAI_ZVEC_EMBEDDING:-local/potion-code-16m-v2}"
    case "$embedding" in local/*) ;; *) die "slim does not authorize remote embedding; configure it separately after explicit review" ;; esac
    zg index "$root" --embedding "$embedding"
  fi
}

cmd_uninstall() {
  local answer
  warn "Detach owned slim policies/proxy? Tools, credentials, indexes and MEGAI data remain. [y/N]"
  read -r answer
  [ "$answer" = y ] || return 0
  # Refuse skill, policy and shell-rc conflicts before changing the connector.
  python3 "$LIB/slim_wiring.py" all --remove --check
  bash "$LIB/plane_mcp.sh" remove --client all || die "Plane removal failed; assets preserved"
  python3 "$LIB/slim_wiring.py" all --remove || die "Slim removal failed; recovery manifests and Plane restore backups retained. Reconcile, then use megai plane restore --client all if needed."
  ok "slim wiring detached; tools, skill kits, backups and project data retained"
}

case "${1:-__project__}" in
  cc) shift; launch_agent cc claude "$@" ;;
  codex) shift; launch_agent codex codex "$@" ;;
  pi) shift; launch_agent pi pi "$@" ;;
  omp) shift; cmd_omp "$@" ;;
  install) bash "$LIB/main.sh" ;;
  update) MEGAI_UPDATE=1 bash "$LIB/main.sh" ;;
  wire) shift; cmd_wire "$@" ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  start) shift; cmd_start "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  logs) [ "${2:-agent-memory}" = agent-memory ] || die "only agent-memory logs are in slim"; tail -f "$MEGAI_HOME/logs/agent-memory.log" ;;
  reindex) cmd_reindex ;;
  plane) shift; bash "$LIB/plane_mcp.sh" "$@" ;;
  dev) bash "$LIB/ensure_dev.sh" ;;
  finish) shift; bash "$LIB/finish_worktree.sh" "$@" ;;
  promote) shift; bash "$LIB/promote_main.sh" "$@" ;;
  uninstall) cmd_uninstall ;;
  version|-v|--version) echo 'megai slim 0.1.0' ;;
  help|-h|--help) usage ;;
  __project__) prepare_core ;;
  *) die "unknown slim command: $1 (megai help)" ;;
esac
