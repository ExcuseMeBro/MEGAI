#!/usr/bin/env bash
# MEGAI slim: Pi-only, local Headroom and Plane-only policies.
set -euo pipefail
MEGAI_HOME="${MEGAI_HOME:-$HOME/.megai}"
LIB="$MEGAI_HOME/lib"
. "$LIB/ui.sh"
. "$LIB/state.sh"

usage() {
  cat <<'EOF'
megai slim
  megai                         Check installed policy and worktree safety
  pi [args]                     Launch Pi without daemon/index preparation
  install | update              Install/reuse the Headroom-based slim stack
  status | doctor               Report core availability (no service startup)
  wire pi|path                  Repair Pi wiring; conflicts fail safely
  headroom [args]               Local compression, retrieve, memory, doctor
  reindex                       Explicit local zvec index/rebuild
  plane [args]                  Secure Plane connector setup/status/removal
  dev                           Switch a clean primary main/master to dev
  finish [args]                 Default verified dev delivery (not retained branches)
  promote --approved            User-approved main promotion only
  uninstall                     Detach owned slim wiring; retain tools/data
  version | help

Stack: codedb, zvec-grep, Headroom, Plane-only task-flow, Ruff,
       agent-worktree-lifecycle, ux-ui-agent-skills, Matt Pocock's skills.
Headroom: local compression, concise output, explicit persistent memory.
Acceptance: original test commands, raw diagnostics, full native diff review.
Infrastructure: native tools, rg/Git, lazy Pi MCP adapter. No auth proxy.
EOF
}

cmd_wire() {
  case "${1:-}" in
    pi|path) bash "$LIB/wire_$1.sh" ;;
    *) die "slim supports only Pi; wire expects pi or path" ;;
  esac
}

prepare_core() {
  python3 "$LIB/slim_wiring.py" pi --verify
  bash "$LIB/ensure_dev.sh" --launch
  ok "slim ready — Headroom is local; indexing remains explicit"
}

launch_agent() {
  command -v pi >/dev/null 2>&1 || die "Pi is not installed; install/authenticate Pi separately"
  python3 "$LIB/slim_wiring.py" pi --verify
  [ -x "$MEGAI_HOME/venv/headroom/bin/python" ] || die "Headroom missing; run megai install"
  bash "$LIB/ensure_dev.sh" --launch
  exec pi "$@"
}

cmd_status() {
  local tool
  for tool in codedb zg ruff git rg; do
    if command -v "$tool" >/dev/null 2>&1; then ok "$tool -> $(command -v "$tool")"; else warn "$tool missing"; fi
  done
  if [ -x "$MEGAI_HOME/venv/headroom/bin/python" ]; then ok "Headroom isolated runtime installed"; else warn "Headroom missing"; fi
  echo "Headroom runs locally on demand; no proxy or memory daemon. Plane: megai plane status --client pi"
}

cmd_doctor() {
  cmd_status
  python3 "$LIB/slim_wiring.py" pi --verify
  local tool
  for tool in python3 node jq git rg codedb zg ruff; do command -v "$tool" >/dev/null 2>&1 || die "$tool required"; done
  [ -f "$MEGAI_HOME/pi-kits/ux-ui-agent-skills/package.json" ] && [ -f "$MEGAI_HOME/pi-kits/ux-ui-agent-skills/.megai-skills/a11y-audit/SKILL.md" ] || die "UX/UI kit is incomplete; run megai install"
  [ -d "$MEGAI_HOME/pi-kits/mattpocock-skills/skills" ] && find "$MEGAI_HOME/pi-kits/mattpocock-skills/skills" -type f -name SKILL.md -print -quit | grep -q . || die "Matt skill kit is incomplete; run megai install"
  local ruff_version
  ruff_version="$(ruff --version)" || die "Ruff version check failed"
  [[ "$ruff_version" == ruff\ * ]] || die "Ruff returned invalid version output"
  "$MEGAI_HOME/bin/megai-headroom" doctor
  bash "$LIB/verify_headroom_activation.sh"
  ok "slim wiring/runtime and Pi activation checks passed; not a model-quality or live Plane check"
}

cmd_reindex() {
  command -v zg >/dev/null 2>&1 || die "zvec-grep missing; run megai install"
  local root embedding
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  if [ -f "$root/.zvec-grep/manifest.json" ]; then
    zg index "$root" --rebuild
  else
    embedding="${MEGAI_ZVEC_EMBEDDING:-local/potion-code-16m-v2}"
    case "$embedding" in local/*) ;; *) die "slim does not authorize remote embedding; configure it separately after explicit review" ;; esac
    zg index "$root" --embedding "$embedding"
  fi
}

cmd_uninstall() {
  local answer
  warn "Detach owned slim policies/extensions? Tools, credentials, indexes and memory data remain. [y/N]"
  read -r answer
  [ "$answer" = y ] || return 0
  python3 "$LIB/slim_wiring.py" pi --remove --check
  bash "$LIB/plane_mcp.sh" remove --client pi || die "Plane removal failed; assets preserved"
  python3 "$LIB/slim_wiring.py" pi --remove || die "Slim removal failed; recovery manifests and Plane restore backups retained. Reconcile, then use megai plane restore --client pi if needed."
  ok "slim wiring detached; tools, skill kits, backups and project data retained"
}

case "${1:-__project__}" in
  pi) shift; launch_agent "$@" ;;
  cc|codex|omp) die "slim requires Pi for parents and all delegates; non-Pi launch is disabled" ;;
  install) python3 "$LIB/install_transaction.py" "$MEGAI_HOME" ;;
  update) MEGAI_UPDATE=1 python3 "$LIB/install_transaction.py" "$MEGAI_HOME" ;;
  wire) shift; cmd_wire "$@" ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  headroom) shift; exec "$MEGAI_HOME/bin/megai-headroom" "$@" ;;
  start|stop|logs) die "daemon commands are retired; use megai headroom (local, on demand)" ;;
  reindex) cmd_reindex ;;
  plane) shift; bash "$LIB/plane_mcp.sh" "$@" ;;
  dev) bash "$LIB/ensure_dev.sh" ;;
  finish) shift; bash "$LIB/finish_worktree.sh" "$@" ;;
  promote) shift; bash "$LIB/promote_main.sh" "$@" ;;
  uninstall) cmd_uninstall ;;
  version|-v|--version) echo 'megai slim 0.2.0' ;;
  help|-h|--help) usage ;;
  __project__) prepare_core ;;
  *) die "unknown slim command: $1 (megai help)" ;;
esac
