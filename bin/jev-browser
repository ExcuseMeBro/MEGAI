#!/usr/bin/env bash
# jev-browser — the Jev Ultrafast browser agent (one goal, Jev-chosen DOM actions).
#
# Upstream is pinned here and resolved into the uv cache on first use: nothing is
# vendored into MEGAI, no credential is written to disk and no key is ever printed.
set -euo pipefail

PIN_URL="https://github.com/browser-use/jev-ultrafast"
PIN_SHA="1231850a0bf1a0c0341fe408ef1668dbbfdfac46"
PACKAGE="jev-ultrafast @ git+$PIN_URL@$PIN_SHA"
TEXT_MODEL_PROVIDER="deepseek"

die() { printf 'jev-browser: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
jev-browser — one goal, a real Chrome tab, Jev-chosen operations

  jev-browser --url URL --goal 'one narrow goal'
  jev-browser --self-check [--prewarm]

  --url URL        page to start from
  --goal TEXT      the goal Jev works toward (single goal)
  --json           one JSON object per step instead of a line per step
  --screenshots    keep page screenshots in the loop (off by default)
  --record-dir DIR record screenshots into DIR (implies screenshots)
  --self-check     offline readiness report: pin, model, credential sources
  --prewarm        with --self-check, also resolve the pinned package into uv's cache

Exit codes: 0 done, 2 the agent chose BLOCKED, 1 error.

Credentials: TYPESAFE_API_KEY (environment, then the macOS keychain service
typesafe.ai) and TEXT_MODEL_API_KEY (environment, then Pi's auth.json DeepSeek key).
TYPESAFE_MODEL defaults to JEV_MODEL or jev-latest. TEXT_MODEL_BASE_URL and
TEXT_MODEL keep the upstream DeepSeek defaults unless you set them.
EOF
}

# The keychain entry the Pi jev extension also reads.
keychain_key() {
  command -v security >/dev/null 2>&1 || return 1
  local value
  value="$(security find-generic-password -s typesafe.ai -w 2>/dev/null)" || return 1
  [ -n "$value" ] || return 1
  printf '%s' "$value"
}

# The API key Pi already stores for a provider. Reads, never writes.
pi_provider_key() {
  python3 - "$1" <<'PY' 2>/dev/null
import json, os, sys
root = os.environ.get("PI_CODING_AGENT_DIR") or os.path.join(os.path.expanduser("~"), ".pi", "agent")
try:
    entry = (json.load(open(os.path.join(root, "auth.json"))) or {}).get(sys.argv[1]) or {}
except (OSError, ValueError):
    raise SystemExit(0)
key = entry.get("key") if entry.get("type") == "api_key" else None
sys.stdout.write(key.strip() if isinstance(key, str) else "")
PY
}

resolve_keys() {
  typesafe_source="missing"
  if [ -n "${TYPESAFE_API_KEY:-}" ]; then
    typesafe_source="environment"
  else
    TYPESAFE_API_KEY="$(keychain_key || true)"
    if [ -n "${TYPESAFE_API_KEY:-}" ]; then
      typesafe_source="keychain typesafe.ai"
    fi
  fi

  TYPESAFE_MODEL="${TYPESAFE_MODEL:-${JEV_MODEL:-jev-latest}}"

  text_source="missing"
  if [ -n "${TEXT_MODEL_API_KEY:-}" ]; then
    text_source="environment"
  else
    TEXT_MODEL_API_KEY="$(pi_provider_key "$TEXT_MODEL_PROVIDER" || true)"
    if [ -n "${TEXT_MODEL_API_KEY:-}" ]; then
      text_source="pi auth.json $TEXT_MODEL_PROVIDER"
    fi
  fi
  export TYPESAFE_API_KEY TYPESAFE_MODEL TEXT_MODEL_API_KEY
}

prewarm_env() {
  if ! command -v uv >/dev/null 2>&1; then
    prewarm_result="no-uv"
    return 0
  fi
  if (cd "${TMPDIR:-/tmp}" && uv run --no-project --with "$PACKAGE" python -c 'import jev_ultrafast') >/dev/null 2>&1; then
    prewarm_result="ok"
  else
    prewarm_result="failed"
  fi
}

self_check() {
  local prewarm="$1" rc=0
  prewarm_result="skipped"
  if ! printf '%s' "$PIN_SHA" | grep -Eq '^[0-9a-f]{40}$'; then
    die "the pinned commit is not a full sha"
  fi
  case "$PIN_URL" in
    https://*) ;;
    *) die "the pinned upstream is not https" ;;
  esac
  if [ "$prewarm" = 1 ]; then
    prewarm_env
  fi
  printf '{"pin":"%s@%s","model":"%s","typesafe_key":"%s","text_model_key":"%s","prewarm":"%s"}\n' \
    "$PIN_URL" "$PIN_SHA" "$TYPESAFE_MODEL" "$typesafe_source" "$text_source" "$prewarm_result"
  [ "$typesafe_source" != missing ] || rc=1
  [ "$text_source" != missing ] || rc=1
  case "$prewarm_result" in
    failed | no-uv) rc=1 ;;
  esac
  if [ "$rc" -ne 0 ]; then
    cat >&2 <<'MSG'
jev-browser: not ready.
  TYPESAFE_API_KEY  set it in the environment, or store it durably with
    security add-generic-password -s typesafe.ai -a "$USER" -w
  TEXT_MODEL_API_KEY  set it, or sign Pi in to DeepSeek (pi /login) so auth.json holds it
MSG
  fi
  return "$rc"
}

run_agent() {
  command -v uv >/dev/null 2>&1 || die "uv is required; run the MEGAI installer first"
  [ -n "$url" ] || die "a run needs --url"
  [ -n "$goal" ] || die "a run needs --goal"
  if [ "$typesafe_source" = missing ] || [ "$text_source" = missing ]; then
    die "credentials are missing; run 'jev-browser --self-check' for the detail"
  fi

  local runner rc
  runner="$(mktemp "${TMPDIR:-/tmp}/jev-browser.XXXXXX.py")"
  trap 'rm -f "$runner"' EXIT
  cat >"$runner" <<'PY'
"""One goal against an observed element table; Jev picks the operation and target."""
import argparse
import json
import sys

from jev_ultrafast import Agent


def summary(state):
    page = state.get("page") or {}
    return {
        "elapsed_ms": state.get("elapsed_ms", 0),
        "status": state.get("status", ""),
        "actions": len(state.get("history") or []),
        "url": page.get("url"),
        "decision": state.get("decision"),
    }


def main():
    parser = argparse.ArgumentParser(prog="jev-browser")
    parser.add_argument("--url", required=True)
    parser.add_argument("--goal", required=True)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--screenshots", action="store_true")
    parser.add_argument("--record-dir")
    args = parser.parse_args()

    state = {}
    with Agent(args.url, args.goal, record_dir=args.record_dir,
               screenshots=args.screenshots) as agent:
        for state in agent.run():
            row = summary(state)
            if args.json:
                print(json.dumps(row), flush=True)
            else:
                print(f"{row['elapsed_ms']:>6} ms  {row['status']:<9} "
                      f"{row['actions']} actions  {row['url']}", flush=True)

    final = summary(state)
    print(json.dumps({"final": final}) if args.json
          else f"final: {final['status']} {final['url']}", flush=True)
    return 0 if final["status"] == "done" else 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
PY

  set -- --url "$url" --goal "$goal"
  [ -z "$record_dir" ] || set -- "$@" --record-dir "$record_dir"
  [ "$json_flag" = 0 ] || set -- "$@" --json
  [ "$screenshots_flag" = 0 ] || set -- "$@" --screenshots

  set +e
  (cd "${TMPDIR:-/tmp}" && uv run --no-project --with "$PACKAGE" python "$runner" "$@")
  rc=$?
  set -e
  exit "$rc"
}

mode=run
prewarm_flag=0
json_flag=0
screenshots_flag=0
url=""
goal=""
record_dir=""

while [ $# -gt 0 ]; do
  case "$1" in
    --self-check) mode=check ;;
    --prewarm) prewarm_flag=1 ;;
    --json) json_flag=1 ;;
    --screenshots) screenshots_flag=1 ;;
    --url)
      [ $# -ge 2 ] || die "--url needs a value"
      url="$2"
      shift
      ;;
    --goal)
      [ $# -ge 2 ] || die "--goal needs a value"
      goal="$2"
      shift
      ;;
    --record-dir)
      [ $# -ge 2 ] || die "--record-dir needs a value"
      record_dir="$2"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "unknown argument: $1"
      ;;
  esac
  shift
done

resolve_keys

if [ "$mode" = check ]; then
  rc=0
  self_check "$prewarm_flag" || rc=$?
  exit "$rc"
fi

run_agent
